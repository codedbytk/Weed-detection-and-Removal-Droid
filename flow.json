  {
    "id": "fn_cmd",
    "type": "function",
    "z": "tab_drive",
    "name": "Check command",
    "func": "// Only five command strings are allowed.\nconst allowed = [\"CMD:F\", \"CMD:B\", \"CMD:L\", \"CMD:R\", \"CMD:S\"];\n\nif (typeof msg.payload !== \"string\" || !allowed.includes(msg.payload)) {\n    node.warn(\"Rejected command: \" + msg.payload);\n    return null;\n}\n\nmsg.topic = \"droid/drive/cmd\";   // MQTT topic the ESP32 listens to\nflow.set(\"lastCmd\", msg.payload); // remember it for debugging\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 160,
    "wires": [["mqtt_cmd", "dbg_cmd", "txt_cmd"]]
  },
