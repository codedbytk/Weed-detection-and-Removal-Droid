  {
    "id": "fn_spd",
    "type": "function",
    "z": "tab_drive",
    "name": "Format speed",
    "func": "// Turn the slider number into the text the ESP32 expects: SPD:0 ... SPD:255\nlet s = Math.round(Number(msg.payload));\n\nif (isNaN(s)) {\n    node.warn(\"Speed is not a number: \" + msg.payload);\n    return null;\n}\n\ns = Math.max(0, Math.min(255, s));   // keep inside 0-255\n\nmsg.payload = \"SPD:\" + s;\nmsg.topic = \"droid/drive/speed\";\nflow.set(\"lastSpeed\", s);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 400,
    "wires": [["mqtt_spd", "dbg_spd", "txt_spd"]]
  },
